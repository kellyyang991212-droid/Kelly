# App 可見設定。只填你的開發代理服務網址；不要在 EXPO_PUBLIC_* 放 Google 金鑰。
# 留空時使用明確標示的本機示範景點。
EXPO_PUBLIC_PLACES_API_URL=

# 選填，手機瀏覽器共用旅行。使用 Publishable key（sb_publishable_…）。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 使用 Supabase Legacy API keys 時，可改填專案的公開 anon 金鑰。
EXPO_PUBLIC_SUPABASE_ANON_KEY=
